rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /topics/{userId}/{topicId}/{fileName} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && resource == null
        && fileName.matches('^cover\\.(jpg|png|webp|gif)$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp|gif)$')
        && request.resource.metadata.ownerId == userId
        && request.resource.metadata.topicId == topicId;

      allow update: if false;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && fileName == 'profile'
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$')
        && request.resource.metadata.ownerId == userId;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
